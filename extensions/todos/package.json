{
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5"
  },
  "atur-terminal": {
    "$schema": "https://raw.githubusercontent.com/dzulfikar08/atur-terminal-extensions/main/schema/manifest.schema.json",
    "description": "Per-project todo list — every Atur Terminal project keeps its own tasks.",
    "commands": [
      {
        "action": {
          "kind": "togglePanel",
          "panel": "todos"
        },
        "defaultShortcut": "cmd+shift+t",
        "id": "toggle-todos",
        "title": "Todos: Toggle Panel"
      },
      {
        "id": "todos-clear-completed",
        "title": "Todos: Clear Completed"
      }
    ],
    "events": [
      "project.switched",
      "projects.changed"
    ],
    "marketplace": {
      "categories": [
        "productivity"
      ],
      "icon": "assets/icon.svg",
      "screenshots": [
        "assets/screenshots/screenshot-1.png"
      ],
      "author": "isfk",
      "github": "dzulfikar08"
    },
    "panels": [
      {
        "entry": "panel/index.html",
        "headerButtons": [
          {
            "command": "todos-clear-completed",
            "icon": {
              "symbol": "trash"
            },
            "id": "clear",
            "tooltip": "Clear completed tasks"
          }
        ],
        "icon": {
          "symbol": "checklist"
        },
        "id": "todos",
        "mode": "pinned",
        "position": "right",
        "title": "Todos"
      }
    ],
    "permissions": [
      "panels:write",
      "projects:read",
      "storage:read",
      "storage:write"
    ],
    "topbarItems": [
      {
        "command": "toggle-todos",
        "icon": {
          "symbol": "checklist"
        },
        "id": "todos",
        "tooltip": "Toggle Todos Panel"
      }
    ]
  },
  "name": "todos",
  "private": true,
  "scripts": {
    "build": "vite build && node scripts/copy-manifest.mjs",
    "dev": "vite"
  },
  "type": "module",
  "version": "1.1.1"
}
