{
  "name": "system-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-background.mjs && node scripts/copy-manifest.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vite": "^7.3.5"
  },
  "atur-terminal": {
    "$schema": "https://raw.githubusercontent.com/dzulfikar08/atur-terminal-extensions/main/schema/manifest.schema.json",
    "description": "CPU, memory, network, battery and disk in the status bar — with sparklines and top processes in a popover.",
    "background": "background.js",
    "permissions": [
      "commands:exec",
      "panels:write",
      "notifications:write",
      "storage:read",
      "storage:write"
    ],
    "events": [],
    "commands": [
      {
        "id": "open-monitor",
        "title": "System Monitor: Open",
        "action": { "kind": "openPopover", "popover": "monitor" }
      },
      {
        "id": "open-settings",
        "title": "System Monitor: Settings",
        "action": {
          "kind": "openModal",
          "entry": "modal/settings.html",
          "width": 460,
          "height": 500
        }
      }
    ],
    "popovers": [
      {
        "id": "monitor",
        "title": "System Monitor",
        "entry": "popover/index.html",
        "width": 340,
        "height": 520
      }
    ],
    "statusBarItems": [
      {
        "id": "stats",
        "icon": { "symbol": "gauge.with.dots.needle.33percent" },
        "side": "right",
        "tooltip": "System Monitor",
        "command": "open-monitor"
      }
    ],
    "marketplace": {
      "author": "Nick Fay",
      "github": "n14395",
      "categories": ["developer-tools", "utilities"],
      "icon": "assets/icon.svg",
      "screenshots": ["assets/screenshots/1.png",
        "assets/screenshots/2.png"]
    }
  }
}
