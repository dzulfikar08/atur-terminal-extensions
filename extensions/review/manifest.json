{
  "$schema": "https://raw.githubusercontent.com/dzulfikar08/atur-terminal-extensions/main/schema/manifest.schema.json",
  "name": "review",
  "version": "0.3.1",
  "description": "An in-app code review tab: file tree, inline git-diff highlighting, and per-line comment threads you can hand off to a coding agent.",
  "permissions": [
    "tabs:read",
    "tabs:write",
    "panes:read",
    "panes:write",
    "projects:read",
    "worktrees:read",
    "commands:exec",
    "notifications:write"
  ],
  "events": [],
  "tabTypes": [
    { "id": "review", "title": "Review", "entry": "tabs/review.html" }
  ],
  "commands": [
    {
      "id": "review:open",
      "title": "Review: Open File Browser",
      "action": { "kind": "openTab", "tabType": "review" }
    }
  ],
  "topbarItems": [
    {
      "id": "review",
      "icon": { "svg": "assets/review.svg" },
      "tooltip": "Open Review",
      "command": "review:open"
    }
  ],
  "marketplace": {
    "author": "Mark Huot",
    "github": "dzulfikar08",
    "categories": ["git", "productivity", "code-review"],
    "icon": "assets/icon.svg",
    "screenshots": ["assets/screenshot-1.png", "assets/screenshot-2.png"]
  }
}
